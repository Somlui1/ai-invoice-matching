# Example config of the AIVA System A test portal.  Copy to .env and fill in your own values.
# .env is gitignored; real environment variables always win over the values in the file.

# ---------------------------------------------------------------- the documents shown in the left panel
# The portal has one source: Paperless itself.  The list comes from the DMS, and "Process" makes System A read
# that document's own file.  The token and the URL are used by System A's own read-only Paperless reader.
PAPERLESS_BASE_URL=http://paperless.internal:8000
PAPERLESS_API_TOKEN=                       # never commit this: put it in your own .env
# the tag that selects which documents to list (the reader resolves the name -> tag id)
PAPERLESS_TAG=invoice
#PAPERLESS_LIMIT=200                       # how many documents the left panel lists

# ---------------------------------------------------------------- System A (used as a library, never copied)
# Folder of the System A project: the one that contains src/system_a, config/ and process_pdf.py.
SYSTEM_A_HOME=C:/Users/you/git/system-a
# inprocess = this process calls System A's own entrypoint process_pdf.process_pdf()  (one process, simplest)
# http      = the reading happens here, the validation runs on a System A server (SYSTEM_A_URL).
#             Start that one from <SYSTEM_A_HOME> with:  python -m system_a.cli serve --port 8080
SYSTEM_A_ENGINE=inprocess
# http only:
SYSTEM_A_URL=http://127.0.0.1:8080
SYSTEM_A_API_KEY=
SYSTEM_A_HTTP_TIMEOUT=300

# The portal keeps no secrets of System A's: LITELLM_URL, LITELLM_API_KEY, MODEL_VISION, ORACLE_BACKEND,
# ORACLE_MCP_URL, ORACLE_MCP_TOKEN ... are read from <SYSTEM_A_HOME>/.env by System A's own loader.
# Anything set here (or in the real environment) wins; only missing keys are filled in from that file.
#USE_SYSTEM_A_ENV=true

# ---------------------------------------------------------------- what System A itself does
SYSTEM_A_MODE=production                   # production = real Oracle + real VLM | sandbox = simulators
SYSTEM_A_AI_MODE=litellm
# offline test (no VLM, no Oracle): use these two instead - the AI-judged rules come back not_evaluated
#SYSTEM_A_MODE=sandbox
#SYSTEM_A_AI_MODE=sim

# ---------------------------------------------------------------- the application
WEBAPP_HOST=127.0.0.1
WEBAPP_PORT=8090
WEBAPP_WORKERS=4                           # documents processed at the same time
# DPI the page images under the boxes are rendered at (72-400).  System A reads the PDF at its own DPI.
#WEBAPP_RENDER_DPI=150
# false = the server writes nothing: the browser keeps the processed cases (localStorage), so a restart of
#         the server leaves no case behind.  true = results are also stored per document in WEBAPP_DATA_DIR.
#WEBAPP_PERSIST=false
#WEBAPP_DATA_DIR=./data
# pass --quick to System A (no table/crop re-read: faster, weaker)
#WEBAPP_QUICK=false
