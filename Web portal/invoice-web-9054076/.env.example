# Set these in the process environment; .env is not auto-loaded.
PORTAL_ENV=development
# Both empty means loopback-only development. Set both for shared-key access.
PORTAL_API_KEY=
PORTAL_INGEST_KEY=
# Default: invoice-web/data. Use an absolute path when overriding.
# PORTAL_DATA_DIR=C:/path/to/portal-data
# Comma-separated additional hosts/origins only when using an approved proxy.
PORTAL_ALLOWED_HOSTS=
PORTAL_ALLOWED_ORIGINS=
