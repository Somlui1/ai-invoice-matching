# ---------------------------------------------------------------- where the documents come from
# paperless = the documents of the DMS themselves (the list comes from Paperless, "Process" reads that file now)
# batch     = a folder the OCR engine already produced; "Process" replays the OCR items of report.html
DOC_SOURCE=batch
#PAPERLESS_BASE_URL=http://paperless.internal:8000
#PAPERLESS_API_TOKEN=                      # never committed here: put it in your own .env
#PAPERLESS_LIMIT=200                       # how many documents the left panel lists
#PAPERLESS_TAGS=                           # comma separated tag names (optional)

# ---------------------------------------------------------------- the batch to review
# report.html of the OCR batch, or the folder that contains it (docs/doc_<id>/page_<n>.jpg is read relative to it)
BATCH_REPORT=C:/Users/you/git/Invoice-auto-matching/OCR service/new engine/tests/out/batch/report.html

# ---------------------------------------------------------------- System A (a separate project)
# Folder of the System A project (the one that contains src/system_a and config/).  Always needed:
# the web application imports System A's contracts and helpers even when the engine runs remotely.
SYSTEM_A_HOME=C:/Users/you/git/system-a
# inprocess = call System A's validate() directly | http = call a running System A (POST /v1/validations)
SYSTEM_A_ENGINE=inprocess
# http only:
SYSTEM_A_URL=http://127.0.0.1:8080
SYSTEM_A_API_KEY=
SYSTEM_A_HTTP_TIMEOUT=300

# In-process, System A reads ITS OWN settings from this same environment (SYSTEM_A_MODE, SYSTEM_A_AI_MODE,
# ORACLE_BACKEND, ORACLE_MCP_URL, ORACLE_MCP_TOKEN, LITELLM_URL ... see System A's .env.example).
# Anything this file does not set is borrowed from <SYSTEM_A_HOME>/.env, so nothing has to be written twice
# (USE_SYSTEM_A_ENV=false turns that off).
SYSTEM_A_MODE=sandbox
SYSTEM_A_AI_MODE=sim
#USE_SYSTEM_A_ENV=true
# sandbox only: Oracle data (default: <SYSTEM_A_HOME>/sandbox_data/oracle_dataset.json)
#WEBAPP_ORACLE_DATASET=

# ---------------------------------------------------------------- what "Process" does
# replay = reuse the OCR items already in report.html, validate them with System A (no GPU, batch only)
# live   = run System A's VisionPipeline (Qwen-VL through LiteLLM) on the document's own file
PERCEPTION=replay
# replay only (see README "Replay mode"):
REPLAY_ASSUME_AGREEMENT=true
REPLAY_CONFIDENCE=0.97
# live only: where the PDFs are (doc_<id>.pdf or <title>.pdf).  Without a PDF the page JPGs are wrapped into one.
#PDF_DIR=
#LITELLM_URL=
#LITELLM_API_KEY=

# ---------------------------------------------------------------- the application
WEBAPP_HOST=127.0.0.1
WEBAPP_PORT=8090
WEBAPP_WORKERS=4
# DPI the pages are rendered at for the bbox overlay (72-400)
#WEBAPP_RENDER_DPI=150
# false = the server writes nothing: the browser keeps the processed cases (localStorage), so a restart
#         leaves no case behind.  true = results are also kept per document in WEBAPP_DATA_DIR.
#WEBAPP_PERSIST=false
# per-document results (survive a restart)
#WEBAPP_DATA_DIR=./data
