# --- mode ---
SYSTEM_A_MODE=sandbox            # sandbox | production
SYSTEM_A_AI_MODE=sim             # sim | litellm
SYSTEM_A_API_KEY=                # REQUIRED in production
RESULT_TTL_SECONDS=86400         # OQ-10 provisional

# --- GB300 via LiteLLM (OpenAI-compatible) ---
LITELLM_URL=                     # e.g. http://aiva.example.com:4000/v1
LITELLM_API_KEY=
MODEL_REASONING=qwen3-reasoning
MODEL_VISION=nvidia/Qwen-VL      # vision model used by perception

# --- perception of real DMS files (perception/vision_pipeline.py) ---
PERCEPTION_DPI=150               # page render DPI for the VLM
PERCEPTION_CROP_DPI=300          # DPI of the zoomed crop re-read
PERCEPTION_MAX_PAGES=12          # pages read per document (more pages -> pages_complete=false, reported)
PERCEPTION_COORD=auto            # auto | pixel | norm1000 | norm1  (bbox_2d coordinate mode)
PERCEPTION_TABLE=1               # extra call per invoice page for row/cell boxes
PERCEPTION_CROPS=1               # zoomed crop re-read of critical fields
PERCEPTION_CLASSIFY=1            # dedicated page-type vote(s)
PERCEPTION_JSON_MODE=1           # send response_format=json_object
PERCEPTION_CACHE_DIR=.cache/perception   # sha256+model+prompt-version keyed extraction cache ("" = off)

# --- Paperless-ngx DMS, READ ONLY (tags/fields are never modified) ---
PAPERLESS_BASE_URL=
PAPERLESS_API_TOKEN=
PAPERLESS_TIMEOUT_SECONDS=120

# --- Oracle: ORDS MCP (default) or read-only replica (Decision Log §7.3) ---
ORACLE_BACKEND=mcp               # mcp | db
ORACLE_MCP_URL=                  # e.g. http://hebs.example.com:8080/mcp
ORACLE_MCP_TOKEN=
ORACLE_DATABASE=default
ORACLE_TIMEOUT_SECONDS=60
ORACLE_DSN=
ORACLE_USER=AIVA_SYSA_RO
ORACLE_PASSWORD=
