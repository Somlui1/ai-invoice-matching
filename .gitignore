# ==============================================================================
# AIVA Invoice Auto-Matching - Global Repository .gitignore
# Covers Company Sensitive Data, Credentials, Financials, ERP Artifacts & Runtimes
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment Configurations & Secrets
# ------------------------------------------------------------------------------
.env
.env.*
*.env
!.env.example
*.secret
*.secrets
secrets/
secret/
vault/
.vault*

# ------------------------------------------------------------------------------
# 2. Authentication Tokens, API Keys & Credentials
# ------------------------------------------------------------------------------
credentials/
*credential*.json
*credentials*.json
!package.json
!package-lock.json
*token*.json
token.json
*service_account*.json
*service-account*.json
client_secret*.json
*.token
*api_key*
*apikey*
auth_token*
id_token*
access_token*
*.p8

# ------------------------------------------------------------------------------
# 3. Certificates, Private Keys & SSH Credentials
# ------------------------------------------------------------------------------
*.key
*.pem
*.pfx
*.p12
*.pkcs12
*.cer
*.crt
*.der
*.csr
*.keystore
*.jks
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub
id_ecdsa
id_ecdsa.pub
id_dsa
id_dsa.pub
*.id_rsa
*.id_ed25519

# ------------------------------------------------------------------------------
# 4. Oracle EBS, ERP & Database Artifacts
# ------------------------------------------------------------------------------
# Oracle Wallet & connection configurations
cwallet.sso
ewallet.p12
tnsnames.ora
sqlnet.ora
listener.ora
ojdbc.properties
*.ora
*.wallet

# Database storage files
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm
data/
Web portal/*/data/
backend/data/

# Database dumps, exports & backups
*.dmp
*.dump
*.bak
*.backup
*.rdb
*dump*.sql
*backup*.sql
*export*.sql
*.sql.gz
*.sql.zip

# ------------------------------------------------------------------------------
# 5. Company Financial Documents, Invoices & Production Payloads
# ------------------------------------------------------------------------------
# All invoice PDFs & scans (keep synthetic test mock fixture)
*.pdf
!Web portal/*/examples/invoice.pdf

# Financial spreadsheets & tabular extracts
*.xlsx
*.xls
*.xlsm
*.xlsb
*export*.csv
*extract*.csv
*report*.csv
*receipt*.csv
*invoice*.csv
*entity*.csv
*entities*.csv
*oracle*.csv

# Batch execution reports & failed run payloads (contain real invoice data)
OCR service/n8n/my_report*.md
OCR service/n8n/my_failed*.json
*my_report*
*my_failed*
*batch_result*.json
*live_run*.json
paperless_downloads/
extracted_invoices/
invoices_raw/
downloads/

# Synthetic corpus generated from production Oracle extracts
OCR service/n8n/tests/test_invoices/_raw/
OCR service/n8n/tests/test_invoices/pdfs/
OCR service/n8n/tests/test_invoices/test_dataset.json

# ------------------------------------------------------------------------------
# 6. n8n & Automation Local State / Exports
# ------------------------------------------------------------------------------
.n8n/
n8n-local/
*n8n_export*.json
*workflow_export*.json

